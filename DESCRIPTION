Package: gutenTAG
Type: Package
Title: MALDI-IHC Data Processing and Quality Control
Version: 0.99.20
Authors@R: c(
    person("John", "Abbey", email = "john.abbey@uzh.ch", role = c("aut", "cre"),
           comment = c(ORCID = "0009-0001-4485-3748")),
    person("Pierre", "Bost", role = "aut"),
    person("Leonardo", "Schwarz", role = "aut")
