current_modularity
while (current_modularity > prev_modularity) {
prev_modularity <- current_modularity
# Local moving phase
for (v in V(graph)) {
# Calculate change in modularity for moving node v to each neighboring community
delta_modularity <- sapply(neighborhoods, function(c) calculate_delta_modularity(graph, v, c))
# Move node v to the community with the largest increase in modularity
community[v] <- names(delta_modularity)[which.max(delta_modularity)]
}
# Refinement phase: build new graph where each node represents a community
graph <- aggregate_graph(graph, community)
# Update modularity
current_modularity <- modularity(graph, community)
}
